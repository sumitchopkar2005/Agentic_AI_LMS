# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_lms
VALKEY_URL=valkey://localhost:6379/0
WEAVIATE_URL=http://localhost:8080
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ─── MinIO (S3-compatible object storage) ─────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-lms-uploads

# ─── vLLM Self-Hosted LLM Endpoints ──────────────────────────
VLLM_BASE_URL_PRIMARY=http://localhost:8000/v1
VLLM_BASE_URL_FAST=http://localhost:8001/v1
VLLM_BASE_URL_VISION=http://localhost:8002/v1
VLLM_MODEL_PRIMARY=Qwen/Qwen2.5-72B-Instruct-AWQ
VLLM_MODEL_FAST=Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL_VISION=Qwen/Qwen2.5-VL-7B-Instruct

# ─── Embedding model ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ─── Whisper (audio transcription) ───────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# ─── Auth ─────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=agentic-lms
JWT_SECRET=change-me-in-production

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_DYNAMIC_HINT_PRICING=false
ENABLE_DEBATE_BOT=false
ENABLE_ECONOMY_BALANCING=false

# ─── App ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
